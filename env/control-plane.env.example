# Copy the relevant values into the repository-root .env file. Compose passes
# only the variables required by the control plane. Never commit the real file.
NODE_ENV=production
PORT=8787
LOG_LEVEL=info

PUBLIC_ORIGIN=https://nuvopic.app
BETTER_AUTH_URL=https://nuvopic.app
BETTER_AUTH_TRUSTED_ORIGINS=https://nuvopic.app
BETTER_AUTH_SECRET=generate-with-openssl-rand-hex-32

CONTROL_DATABASE_NAME=nuvopic_control
CONTROL_DATABASE_USER=nuvopic_control
CONTROL_DATABASE_PASSWORD=generate-with-openssl-rand-hex-32
# Used only by the isolated workspace-provisioner container.
POSTGRES_ADMIN_USER=nuvopic_admin
POSTGRES_ADMIN_PASSWORD=generate-with-openssl-rand-hex-32
DATABASE_URL=postgres://nuvopic_control:replace-me@postgres:5432/nuvopic_control
DATABASE_SSL=false
PROVISIONER_POLL_INTERVAL_SECONDS=3
PROVISIONER_BATCH_SIZE=10

MANAGED_JWT_ISSUER=https://nuvopic.app
MANAGED_JWT_AUDIENCE=nuvopic
MANAGED_JWT_KEY_ID=nuvopic-managed-YYYY-MM-DD
MANAGED_JWT_TTL_SECONDS=300
# Compose dotenv syntax: store the PEM on one line with literal \n separators.
MANAGED_JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----"

MANAGED_WORKSPACE_DIRECTORY_TOKEN=generate-with-openssl-rand-hex-32
NUVOPIC_BASE_URL=https://nuvopic.app/app/photos
PLATFORM_ADMIN_EMAILS=owner@example.com
# Defaults to PLATFORM_ADMIN_EMAILS when empty.
PRIVATE_ALPHA_ALLOWED_EMAILS=owner@example.com

# Production-only immutable images. Build each from the corresponding target.
CONTROL_PLANE_IMAGE=registry.example/nuvopic-control:release-runtime
CONTROL_PLANE_MIGRATION_IMAGE=registry.example/nuvopic-control:release-migration
