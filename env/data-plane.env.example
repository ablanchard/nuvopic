# Copy the relevant values into the repository-root .env file. Compose passes
# only the variables required by the data plane. Never commit the real file.
NODE_ENV=production
PORT=8080
LOG_LEVEL=info
DEPLOY_MODE=managed

PUBLIC_ORIGIN=https://nuvopic.app
SETTINGS_KEK=generate-with-openssl-rand-hex-32

MANAGED_JWT_ISSUER=https://nuvopic.app
MANAGED_JWT_AUDIENCE=nuvopic
MANAGED_JWKS_URL=http://control-plane:8787/.well-known/jwks.json
MANAGED_WORKSPACE_DIRECTORY_URL=http://control-plane:8787/internal/workspaces/resolve
MANAGED_WORKSPACE_DIRECTORY_TOKEN=same-value-as-control-plane
MANAGED_TOKEN_ENDPOINT=/managed/session/token
MANAGED_PROFILE_PATH=/profile
MANAGED_ADMIN_PATH=/admin

# Configure credentials for only the providers selected below.
PROCESSING_MODE=modal
BATCH_GPU_PROVIDER=vastai
MODAL_ENDPOINT_URL=https://your-workspace--nuvopic-inference-analyze.modal.run
MODAL_PROXY_KEY=replace-me
MODAL_PROXY_SECRET=replace-me
VAST_API_KEY=replace-me
VAST_DOCKER_IMAGE=registry.example/nuvopic-inference:immutable-tag
VAST_INFERENCE_API_KEY=replace-me
VAST_GPU_TYPE=RTX 3090
VAST_MAX_PRICE_PER_HOUR=0.30
VAST_DISK_GB=20
VAST_USE_INTERRUPTIBLE=true
VAST_BID_PRICE=0.10
VAST_MAX_REPROVISIONS=3

# Production-only immutable images. Build each from the corresponding target.
DATA_PLANE_IMAGE=registry.example/nuvopic-data:release-runtime
DATA_PLANE_MIGRATION_IMAGE=registry.example/nuvopic-data:release-migration
