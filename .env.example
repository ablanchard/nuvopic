# =============================================================================
# Database (PostgreSQL with pgvector extension)
# Any PostgreSQL provider works: Supabase, Neon, AWS RDS, self-hosted, etc.
# =============================================================================
# DEPLOY_MODE=standalone
DATABASE_URL=postgres://user:password@host:5432/dbname
# Set to "true" to enable SSL connections (required for most cloud providers)
# DATABASE_SSL=true
# Used to encrypt secret settings stored in the database
SETTINGS_KEK=replace-with-a-random-secret

# =============================================================================
# S3-compatible Object Storage (migration input only)
# These values are imported into the NuvoPic settings table by:
#   npm run migrate-s3-settings
# Runtime bucket configuration is read from the database, not from env vars.
# =============================================================================
S3_BUCKET=my-photos
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_REGION=us-east-1
# Custom endpoint for non-AWS providers (e.g., https://s3.fr-par.scw.cloud)
# S3_ENDPOINT=https://s3.provider.com
# Required for MinIO and some S3-compatible providers
# S3_FORCE_PATH_STYLE=true

# =============================================================================
# Authentication (optional - if not set, the app is publicly accessible)
# =============================================================================
# Password to access the application (single-user auth)
# AUTH_PASSWORD=your-secure-password
# Secret key for signing session tokens (generate with: openssl rand -hex 32)
# JWT_SECRET=your-random-secret

# =============================================================================
# Processing Mode (optional)
# "modal"  = GPU-accelerated via Modal (requires MODAL_* vars below)
# "vastai" = GPU-accelerated via Vast.ai (requires VAST_* vars below)
# "local"  = CPU-based, uses @xenova/transformers + face-api.js
# If not set, auto-detects: uses Modal if MODAL_ENDPOINT_URL is configured
# =============================================================================
# PROCESSING_MODE=modal

# =============================================================================
# Batch GPU Provider (optional — for import/reprocess operations)
# Override which GPU provider is used for batch processing.
# "modal"  = use Modal (same as realtime)
# "vastai" = use Vast.ai (cheaper for large batches, auto-provisions instance)
# If not set, uses the same provider as PROCESSING_MODE.
# =============================================================================
# BATCH_GPU_PROVIDER=vastai

# =============================================================================
# Modal GPU Inference (required when PROCESSING_MODE=modal)
# Deploy the endpoint with: modal deploy modal/inference.py
# =============================================================================
# MODAL_ENDPOINT_URL=https://your-workspace--nuvopic-inference-analyze.modal.run
# MODAL_PROXY_KEY=ak-xxx
# MODAL_PROXY_SECRET=as-xxx

# =============================================================================
# Vast.ai GPU Inference (required when BATCH_GPU_PROVIDER=vastai)
# Build & push the Docker image: docker build -f modal/Dockerfile -t yourdockerhub/nuvopic-inference:latest . && docker push ...
# =============================================================================
# VAST_API_KEY=your-vast-api-key
# VAST_DOCKER_IMAGE=bobmoriss/nuvopic-inference:latest
# VAST_INFERENCE_API_KEY=your-secret-bearer-token
# VAST_GPU_TYPE=RTX 3090
# VAST_MAX_PRICE_PER_HOUR=0.30
# VAST_DISK_GB=20
# --- Interruptible (bid/spot) instances — ~70% cheaper, auto-reprovision on eviction ---
# VAST_USE_INTERRUPTIBLE=true
# Optional fixed bid. When omitted, NuvoPic uses the selected offer price.
# VAST_BID_PRICE=0.25
# VAST_BID_MARGIN_PERCENT=10
# VAST_INTERRUPTIBLE_ALLOCATIONS=1
# VAST_MAX_PROVISION_TIME_MS=300000
# VAST_MAX_REPROVISIONS=3

# Volume routing keeps complete batches of 500 photos or fewer on Modal and
# sends larger batches to Vast.ai when both providers are configured.
# GPU_PROVIDER_ROUTING_ENABLED=true
# GPU_PROVIDER_BATCH_THRESHOLD=500

# =============================================================================
# Server
# =============================================================================
# PORT=8080
# LOG_LEVEL=info
# AUTO_IMPORT_POLL_INTERVAL_MS=10000
# MANUAL_IMPORT_JOB_POLL_INTERVAL_MS=2000
# MANUAL_IMPORT_BATCH_SIZE=1000
# REPROCESS_BATCH_SIZE=1000
# GPU_RESOURCE_CLEANUP_POLL_INTERVAL_MS=30000

# =============================================================================
# Managed Mode (optional)
# NuvoPic validates SaaS-issued JWTs and resolves workspace DBs dynamically.
# =============================================================================
# DEPLOY_MODE=managed
# MANAGED_JWKS_URL=https://control-plane.example.com/.well-known/jwks.json
# MANAGED_JWT_ISSUER=https://control-plane.example.com
# MANAGED_WORKSPACE_DIRECTORY_URL=https://control-plane.example.com/internal/workspaces/resolve
# MANAGED_WORKSPACE_DIRECTORY_LIST_URL=https://control-plane.example.com/internal/workspaces
# MANAGED_WORKSPACE_DIRECTORY_TOKEN=internal-api-token
# GPU_METERING_URL=https://control-plane.example.com
# GPU_METERING_SERVICE_TOKEN=a-dedicated-metering-token
# GPU_METERING_MODE=shadow
# GPU_METERING_REQUEST_TIMEOUT_MS=10000
# PROCESSING_JOB_POLL_INTERVAL_MS=10000
# MANAGED_TOKEN_ENDPOINT=/managed/session/token
# MANAGED_PROFILE_PATH=/profile
# MANAGED_ADMIN_PATH=/admin
