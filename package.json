{
  "name": "nuvopic",
  "version": "1.0.0",
  "description": "Visualize and organize your photos stored on cloud storage",
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "init-db": "tsx scripts/init-db.ts",
    "backfill-locations": "tsx scripts/backfill-locations.ts",
    "provision-workspaces": "tsx scripts/provision-workspaces.ts",
    "migrate-s3-settings": "tsx scripts/migrate-s3-settings.ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:typecheck": "tsc --noEmit -p tsconfig.playwright.json",
    "webapp:dev": "npm run dev --prefix webapp",
    "webapp:build": "npm run build --prefix webapp",
    "webapp:preview": "npm run preview --prefix webapp -- --host 127.0.0.1 --port 4173",
    "build:all": "npm run build && npm run webapp:build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.999.0",
    "@hono/node-server": "^1.19.9",
    "dotenv": "^17.3.1",
    "exif-reader": "^2.0.1",
    "geokdbush": "^2.1.0",
    "hono": "^4.11.7",
    "kdbush": "^4.1.0",
    "pg": "^8.13.0",
    "sharp": "^0.33.5",
    "world-cities-json": "^1.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
